#%PAM-1.0
# No pam_gnome_keyring here, deliberately: the login keyring is unlocked by
# the TPM-sealed gnome-keyring-daemon unit (README, "Login keyring"), the one
# provider. This module started a second daemon at every login, which could
# not unlock the keyring (its password is the sealed one) and raced the unit.

auth       include      system-local-login

account    include      system-local-login

password   include      system-local-login

session    include      system-local-login
