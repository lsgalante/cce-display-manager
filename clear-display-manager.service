[Unit]
Description=Clear Display Manager
After=systemd-user-sessions.service plymouth-quit-active.service
Conflicts=getty@tty1.service
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/clear-display-manager
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user

[Install]
WantedBy=graphical.target
